# Copy this file to backend/.env and fill in your credentials.
# Never commit backend/.env or backend/service-account.json.

PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

# Gemini API (Google AI Studio key — required for live agent calls)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-4-hydrogen

# GCP Database — Firestore in MongoDB-compatible mode (primary)
# Example: mongodb://<user>:<pass>@<uid>.<region>.firestore.goog:443/samajh?loadBalanced=true&tls=true&authMechanism=SCRAM-SHA-256&retryWrites=false
MONGO_CONNECTION_STRING=
MONGODB_DB_NAME=samajh

# GCP Database — Optional fallback: Google Cloud Firestore (Native mode)
# Place your GCP service account key at backend/service-account.json (gitignored)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIRESTORE_DATABASE_ID=(default)

# Optional: Vertex AI Search (Discovery Engine) for NISM workbook RAG grounding
# If omitted, Samajh automatically grounds against backend/src/data/nismWorkbookCorpus.json
VERTEX_SEARCH_DATASTORE_ID=
VERTEX_SEARCH_LOCATION=global

# Server-side secret for HMAC-SHA256 tamper-evident credential signatures (Prompt 4)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_SIGNING_KEY=your_random_32_byte_hex_secret_here

# Optional: Polygon Amoy Soulbound Token (SBT) Relayer (Prompt 5 — additive only)
# Fund this wallet ahead of time with Polygon Amoy testnet POL/MATIC from an Amoy faucet.
# If omitted or RPC is slow, Firestore HMAC-SHA256 verification continues working normally.
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
RELAYER_PRIVATE_KEY=
SBT_CONTRACT_ADDRESS=
